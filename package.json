{
  "name": "flores-internal-pos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules/.vite .vite dist",
    "dev": "npm run clean && vite --host 0.0.0.0",
    "backend": "node backend/server.js",
    "dev:full": "npm run clean && concurrently \"npm run backend\" \"vite --host 0.0.0.0\"",
    "build": "npm run clean && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.2",
    "typescript": "^5.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "lucide-react": "^0.487.0",
    "express": "^4.19.2",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "ws": "^8.18.0",
    "concurrently": "^9.1.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1"
  }
}
